---
/* Styles */
import './styles/navigation.scss';

/* Scripts */
import type { NavigationListItemProps, NavigationListItemAttributesType } from './scripts/navigation-types';

/* Define prop types */
type Props = NavigationListItemProps;

/* Props */
const { item } = Astro.props;

/* Create link props */
let linkProps: NavigationListItemAttributesType = {
	class: 'navigation-link',
	href: item.url,
}
if (item.type == 'link') {
	linkProps = {
		...linkProps,
		target: '_blank',
		rel: 'noreferrer'
	}
}
---

<li class="navigation-list-item">
	<a title={item.label} {...linkProps}>{item.label}</a>
	<slot />
</li>