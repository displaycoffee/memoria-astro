---
/* Styles */
import './styles/navigation.scss';

/* Scripts */
import type { NavigationProps } from './scripts/navigation-types';
import { context } from '../../context/scripts/context';

/* Components */
import NavigationListItem from './NavigationListItem.astro';
import { Dropdown } from '../dropdown/Dropdown';

/* Define prop types */
type Props = NavigationProps;

/* Props */
const { direction, id, label, menu, name, showChildren } = Astro.props;
const showNavChildren = showChildren ?? true;
const navDirection = direction == 'horizontal' || direction == 'vertical' ? direction : 'horizontal';

/* Get menu */
const navigationList = menu ?? await context.wp.menu.menu(name);
---

{navigationList.length !== 0 ? (
	<nav id={`navigation-${id}`} class={`navigation navigation-${id}`} aria-label={label}>
		<ul class={`navigation-list navigation-list-${navDirection} unstyled`}>
			{navigationList.map((nav: MenuType) => {
				const dropdownId = `${id} ${nav.id.replace(/-/g, ' ')}`;
				
				return (
					<NavigationListItem item={nav}>
						{nav.children.length !== 0 && showNavChildren ? (
							<Dropdown buttonLabel={`${nav.label} Menu`} closeOnClick={true} showLabel={false} id={dropdownId} client:idle>
								<ul class="navigation-list-submenu unstyled">
									{nav.children.map((child: MenuItemType) => {
										return (
											<NavigationListItem item={child} />
										);
									})}
								</ul>
							</Dropdown>
						) : (null)}
					</NavigationListItem>
				)
			})}
		</ul>
	</nav>
) : (null)}