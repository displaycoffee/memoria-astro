---
/* Styles */
import './styles/navigation.scss';

/* Scripts */
import type { NavigationProps } from './scripts/navigation-types';
import { context } from '../../context/scripts/context';

/* Components */
import NavigationListItem from './NavigationListItem.astro';
import { Dropdown } from '../dropdown/Dropdown';

/* Define prop types */
type Props = NavigationProps;

/* Props */
const { name } = Astro.props;

/* Get menu */
const navigationList = await context.wp.menu(name);
---

<nav class="navigation">
	<ul class="navigation-list unstyled">
		{navigationList.map((nav: MenuType) => {
			return (
				<NavigationListItem item={nav}>
					{nav.children.length !== 0 ? (
						<Dropdown closeOnClick={true} id={nav.id.replace(/-/g, ' ')} client:visible>
							<ul class="navigation-list-submenu unstyled">
								{nav.children.map((child: MenuItemType) => {
									return (
										<NavigationListItem item={child} />
									);
								})}
							</ul>
						</Dropdown>
					) : (null)}
				</NavigationListItem>
			)
		})}
	</ul>
</nav>