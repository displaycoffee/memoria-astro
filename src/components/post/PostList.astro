---
/* Styles */
import './styles/post.scss';

/* Scripts */
import type { PostListProps } from './scripts/post-types';

/* Components */
import Image from '../image/Image.astro';

/* Define prop types */
type Props = PostListProps;

/* Props */
const { posts } = Astro.props;
---

<div class="posts row row-wrap row-spacing-20">
	{posts.map((post: PostType) =>  {
		console.log(post)
		return (
			<div id={`post-${post.id}`} class="post column column-width-33">
				<div class="post-image">
					<a href={post.url}>
						<Image
							alt={post.image.alt}
							hasLazy={true}
							image={post.image.url}
							wrapperClasses={['fluid', 'fit']}
						/>
					</a>
				</div>

				<div class="post-details">
					<h3 class="h5">
						<a href={post.url}>{post.title}</a>
					</h3>

					<p>
						{post?.author?.name ? `By ${post.author.name} on ` : ``}
						{post.date}
					</p>

					<p>{post.excerpt}</p>

					<a class="button" href={post.url}>
						Read More
					</a>
				</div>
			</div>
		);
	})}
</div>