---
/* Styles */
import './styles/post.scss';

/* Scripts */
import type { PostProps } from './scripts/post-types';

/* Components */
import { PostImage, PostMeta, PostTaxonomies } from './PostBlocks';

/* Define prop types */
type Props = PostProps;

/* Props */
const { post } = Astro.props;
---

<div id={post.id} class="post">
	{!post.image.url.includes('placeholder') ? (
		<PostImage post={post} />
	) : null}

	<div class="post-details">
		<h2 class="post-title">
			<a href={post.url}>{post.title}</a>
		</h2>

		<PostMeta post={post} />

		<div class="post-content margin-trim" set:html={post.content}></div>

		<PostTaxonomies post={post} />
	</div>
</div>