---
/* Styles */
import './styles/post.scss';

/* Scripts */
import type { PostProps } from './scripts/post-types';

/* Components */
import { ErrorBoundary } from '../error-boundary/ErrorBoundary';
import { PostImage, PostMeta, PostTaxonomies } from './PostBlocks';

/* Define prop types */
type Props = PostProps;

/* Props */
const { post } = Astro.props;
---

<div id={post.id} class="post">
	{!post.image.url.includes('placeholder') ? (
		<ErrorBoundary message="Something went wrong loading this image.">
			<PostImage post={post} />
		</ErrorBoundary>
	) : null}

	<div class="post-details">
		<h2 class="post-title">
			<a href={post.url}>{post.title}</a>
		</h2>

		<ErrorBoundary message="Something went wrong loading this post's details.">
			<PostMeta post={post} />
		</ErrorBoundary>

		<div class="post-content margin-trim" set:html={post.content}></div>

		<ErrorBoundary message="Something went wrong loading this post's categories/tags.">
			<PostTaxonomies post={post} />
		</ErrorBoundary>
	</div>
</div>