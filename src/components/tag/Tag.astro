---
/* Styles */
import './styles/tag.scss';

/* Scripts */
import type { TagProps } from './scripts/tag-types';

/* Components */
import PostList from '../post/PostList.astro';

/* Define prop types */
type Props = TagProps;

/* Props */
const { posts, tag } = Astro.props;
---

<div id={tag.id} class="tag">
	<div class="tag-details">
		<h2 class="tag-title">
			<a href={tag.url}>{tag.name}</a>
		</h2>

		{tag.content && (
			<div class="tag-content margin-trim" set:html={tag.content}></div>
		)}
	</div>

	<div class="tag-posts">
		<PostList posts={posts} />
	</div>
</div>
