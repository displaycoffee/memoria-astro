---
/* Styles */
import './styles/tag.scss';

/* Scripts */
import type { TagListProps } from './scripts/tag-types';

/* Define prop types */
type Props = TagListProps;

/* Props */
const { tags } = Astro.props;
---

<div class="tags row row-wrap row-spacing-20">
	{tags.map((tag: TagType) => {
		return (
			<div id={tag.id} class="tag column column-width-50">
				<div class="tag-details">
					<h3 class="tag-title h5">
						<a href={tag.url}>{tag.name}</a>
					</h3>

					<div class="tag-content">
						<p>{tag.excerpt}</p>
					</div>

					<div class="tag-read-more">
						<a class="button" href={tag.url}>
							Read More
						</a>
					</div>
				</div>
			</div>
		);
	})}
</div>