---
/* Styles */
import './styles/pagination.scss';

/* Scripts */
import type { PaginationProps } from './scripts/pagination-types';

/* Define prop types */
type Props = PaginationProps;

/* Props */
const { basePath, page } = Astro.props;

/* Nothing to paginate */
if (page.lastPage <= 1) {
	return;
}

/* Build the URL for a given page number */
const pageUrl = (pageNumber: number) => {
	return pageNumber === 1 ? basePath : `${basePath}/${pageNumber}`;
};

/* Build a windowed list of page numbers, collapsing gaps into an ellipsis */
type PaginationItem = { number: number; type: 'page' } | { type: 'ellipsis' };

/* Set siblings */
const siblingCount = 2;
const siblings = Array.from({ length: siblingCount * 2 + 1 }, (_, index) => page.currentPage - siblingCount + index);

/* How many page numbers to show on either side of the current page */
const visiblePages = [...new Set([1, page.lastPage, ...siblings])]
	.filter((number) => number >= 1 && number <= page.lastPage)
	.sort((a, b) => a - b);

/* Create pages for pagination */
const pages: PaginationItem[] = [];
visiblePages.forEach((number, index) => {
	if (index > 0 && number - visiblePages[index - 1] > 1) {
		pages.push({ type: 'ellipsis' });
	}
	pages.push({ number, type: 'page' });
});
---

<nav class="pagination" aria-label="Pagination">
	<ul class="pagination-list row row-nowrap row-spacing-10 row-align-items-center unstyled">
		{page.url.prev && (
			<li class="pagination-list-item">
				<a class="pagination-previous button" href={page.url.prev} rel="prev">Previous</a>
			</li>
		)}

		{pages.map((item) => (
			<li class="pagination-list-item">
				{item.type === 'ellipsis' ? (
					<span class="pagination-ellipsis">&hellip;</span>
				) : (
					<a
						class="pagination-link"
						href={pageUrl(item.number)}
						aria-current={item.number === page.currentPage ? 'page' : undefined}
					>
						{item.number}
					</a>
				)}
			</li>
		))}

		{page.url.next && (
			<li class="pagination-list-item">
				<a class="pagination-next button" href={page.url.next} rel="next">Next</a>
			</li>
		)}
	</ul>
</nav>
