---
/* Styles */
import './styles/search-form.scss';

/* Scripts */
import type { SearchFormProps } from './scripts/search-types';

/* Components */
import Icons from '../icons/Icons.astro';

/* Define prop types */
type Props = SearchFormProps;

/* Props */
const { action, id } = Astro.props;

/* Search form variables */
const searchInputId = `${id}-input`;
---

<form id={id} class="search-form flex-nowrap flex-align-items-center" role="search" method="get" action={action}>
	<div class="form-field form-field-close">
		<label class="label" for={searchInputId}>
			Search
		</label>

		<input id={searchInputId} class="input" type="text" placeholder="Search for..." value="" name="q" />

		<button class="button-close unstyled icon-wrapper" type="button">
			<Icons id={'close'} />
		</button>
	</div>

	<button class="button" type="submit">
		<Icons id={'search'} />
		<span class="button-label">Submit</span>
	</button>
</form>