---
/* Styles */
import './styles/page.scss';

/* Scripts */
import type { PageListProps } from './scripts/page-types';

/* Components */
import { ErrorBoundary } from '../error-boundary/ErrorBoundary';
import { PageList as PageListReact } from './PageList';

/* Define prop types */
type Props = PageListProps;
---

<ErrorBoundary message="Something went wrong loading this list of pages.">
	<PageListReact {...Astro.props} />
</ErrorBoundary>