---
/* Styles */
import './styles/author.scss';

/* Scripts */
import type { AuthorListProps } from './scripts/author-types';

/* Define prop types */
type Props = AuthorListProps;

/* Props */
const { authors } = Astro.props;
---

<div class="authors row row-wrap row-spacing-20">
	{authors.map((author: AuthorType) => {
		return (
			<div id={author.id} class="author column column-width-50">
				<div class="author-details">
					<h3 class="author-title h5">
						<a href={author.url}>{author.name}</a>
					</h3>

					<div class="author-content">
						<p>{author.excerpt}</p>
					</div>

					<div class="author-read-more">
						<a class="button" href={author.url}>
							Read More
						</a>
					</div>
				</div>
			</div>
		);
	})}
</div>