---
/* Styles */
import './styles/category.scss';

/* Scripts */
import type { CategoryListProps } from './scripts/category-types';

/* Define prop types */
type Props = CategoryListProps;

/* Props */
const { categories } = Astro.props;
---

<div class="categories row row-wrap row-spacing-20">
	{categories.map((category: CategoryType) => {
		return (
			<div id={category.id} class="category column column-width-50">
				<div class="category-details">
					<h3 class="category-title h5">
						<a href={category.url}>{category.name}</a>
					</h3>

					{category.excerpt && (
						<div class="category-content margin-trim">{category.excerpt}</div>
					)}

					<div class="category-read-more">
						<a class="button" href={category.url}>
							Read More<span class="sr-only"> about {category.name}</span>
						</a>
					</div>
				</div>
			</div>
		);
	})}
</div>