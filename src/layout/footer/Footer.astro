---
/* Styles */
import './styles/footer.scss';

/* Scripts */
import type { FooterProps } from './scripts/footer-types';

/* Components */
import Icons from '../../components/icons/Icons.astro';

/* Define prop types */
type Props = FooterProps;

/* Props */
const { options } = Astro.props;

/* Get year */
const year = new Date().getFullYear();
---

<footer class="footer">
	{options.footer.blocks.length !== 0 ? (
		<div class="footer-blocks row row-wrap row-fit row-spacing-20">
			{options.footer.blocks.map((block) => (
				<div id={block.id} class="footer-block column" set:html={block.content}></div>
			))}
		</div>
	) : (null)}

	<div class="footer-blocks row row-wrap row-fit row-spacing-20">
		{options.social.length !== 0 ? (
			<div id="footer-social" class="footer-social footer-block column">
				<nav class="footer-social-links">
					{options.social.map((social) => (
						<a title={social.label} class="footer-social-link" href={social.url} target="_blank" rel="noreferrer">
							<Icons id={social.id} size={'x-large'} />
						</a>
					))}
				</nav>
			</div>
		) : (null)}
		
		<div id="footer-copyright" class="footer-copyright footer-block column">
			<p>&copy; {year} <a href="//display.coffee" target="_blank" rel="noreferrer">displaycoffee</a></p>
		</div>
	</div>
</footer>