---
/* Styles */
import './styles/footer.scss';

/* Scripts */
import type { FooterProps } from './scripts/footer-types';

/* Components */
import { context } from '../../context/scripts/context';
import Icons from '../../components/icons/Icons.astro';
import Navigation from '../../components/navigation/Navigation.astro';

/* Define prop types */
type Props = FooterProps;

/* Props */
const { options } = Astro.props;

/* Get year */
const year = new Date().getFullYear();

/* Get footer menu to conditionally render nav block */
const footerMenu = await context.wp.menu.menu('footer');
---

<footer class="footer">
	{options.footer.blocks.length !== 0 ? (
		<div class="footer-blocks row row-wrap row-fit row-spacing-20">
			{options.footer.blocks.map((block) => (
				block.content == 'nav menu' ? (
					footerMenu.length !== 0 ? (
						<div id={block.id} class="footer-block column">
							<Navigation direction={'vertical'} id={'footer'} label={'Footer Navigation'} menu={footerMenu} showChildren={false} />
						</div>
					) : null
				) : (
					<div id={block.id} class="footer-block column" set:html={block.content}></div>
				)
			))}
		</div>
	) : (null)}

	<div class="footer-blocks row row-wrap row-fit row-spacing-20">
		{options.social.length !== 0 ? (
			<div id="footer-social" class="footer-social footer-block column">
				<nav class="footer-social-links" aria-label={'Social Links'}>
					{options.social.map((social) => (
						<a aria-label={social.label} class="footer-social-link" href={social.url} target="_blank" rel="noreferrer">
							<Icons id={social.id} size={'x-large'} />
						</a>
					))}
				</nav>
			</div>
		) : (null)}
		
		<div id="footer-copyright" class="footer-copyright footer-block column">
			<p>&copy; {year} <a href="//display.coffee" target="_blank" rel="noreferrer">displaycoffee</a></p>
		</div>
	</div>
</footer>