---
/* Styles */
import './styles/container.scss';

/* Scripts */
import { slide } from 'astro:transitions';
import { context } from '../../context/scripts/context';

/* Components */
import Head from '../head/Head.astro';
import Header from '../header/Header.astro';
import Navigation from '../../components/navigation/Navigation.astro';
import Content from '../content/Content.astro';
import Sidebar from '../sidebar/Sidebar.astro';
import Footer from '../footer/Footer.astro';
import IconMap from '../../components/icons/IconMap.astro';
import { SlideoutOverlay, Slideout } from '../../components/slideout/Slideout';

/* Get theme options */
const options = await context.wp.themeOptions();

/* Create body class */
const pathname = Astro.url.pathname;
const bodyClass = pathname === '/' ? 'home' : context.utils.any.handleize(pathname);

/* Slideout options */
const slideoutOptions = {
	id: 'navigation-menu',
	label: 'Menu',
	closeOnClick: true,
	button: {
		outside: false,
		show: true,
	},
};
---

<!doctype html>
<html lang="en">
	<Head />
	
	<body class={`scrollbar page-${bodyClass}`}>
		<div id="container" class="container">			
			<Header options={options} />
			
			<div class="hide-mobile">
				<Navigation name={'primary'} />
			</div>

			<div class="hide-desktop">
				<SlideoutOverlay client:load />

				<Slideout options={slideoutOptions} client:visible>
					<Navigation name={'primary'} />
				</Slideout>
			</div>

			<main class="main" transition:animate={slide({ duration: '0.5s' })}>
				<div class="main-layout flex-wrap">
					<Content>
						<slot />
					</Content>

					<Sidebar slug={options?.sidebar?.slug ?? ''} />
				</div>
			</main>

			<Footer options={options} />

			<button data-scroll-to="scroll-to-top" class="pointer unstyled a" type="button" aria-label="Scroll to top button">
				Scroll to top
			</button>
		</div>

		<IconMap />

		<script>
			import { closeFormFields } from './scripts/forms.ts';
			import { context } from '../../context/scripts/context';

			// Close form fields
			closeFormFields('.form-field-close', '.input', '.button-close');

			// Set scroll to top functionality
			const scrollToTopButton = document.querySelector('[data-scroll-to="scroll-to-top"]');

			if (scrollToTopButton) {
				scrollToTopButton.addEventListener('click', (e) => {
					context.utils.browser.scrollTo(e, 'body');
				});
			}
		</script>
	</body>
</html>