---
/* Scripts */
import { context } from '../../context/scripts/context.ts';

/* Components */
import Container from '../../layout/container/Container.astro';
import AuthorList from '../../components/author/AuthorList.astro';

/* Get authors */
const authors = await context.wp.author.authors(12);

/* Page title */
const pageTitle = 'Authors';
---

<Container title={pageTitle}>
	<h2>{pageTitle}</h2>

	<AuthorList authors={authors} />
</Container>