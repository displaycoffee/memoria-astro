---
/* Scripts */
import type { GetStaticPathsOptions } from 'astro';
import { context } from '../../context/scripts/context.ts';

/* Components */
import AuthorList from '../../components/author/AuthorList.astro';
import Container from '../../layout/container/Container.astro';
import Pagination from '../../components/pagination/Pagination.astro';

/* Get authors */
export const getStaticPaths = async ({ paginate }: GetStaticPathsOptions) => {
	const authors = await context.wp.author.all();
	return paginate(authors, { pageSize: 12 });
};

/* Define prop types */
import type { InferGetStaticPropsType } from 'astro';
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

/* Props */
const { page } = Astro.props;

/* Page details */
const pageDetails = {
	path: `/authors`,
	title: `Authors`,
};
---

<Container title={pageDetails.title}>
	<h2>{pageDetails.title}</h2>

	<AuthorList authors={page.data} />

	<Pagination page={page} basePath={pageDetails.path} />
</Container>
