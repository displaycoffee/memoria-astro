---
/* Scripts */
import { context } from '../../context/scripts/context.ts';

/* Components */
import Container from '../../layout/container/Container.astro';
import CategoryList from '../../components/category/CategoryList.astro';

/* Get categories */
const categories = await context.wp.category.categories(12);

/* Page title */
const pageTitle = 'Categories';
---

<Container title={pageTitle}>
	<h2>{pageTitle}</h2>

	<CategoryList categories={categories} />
</Container>