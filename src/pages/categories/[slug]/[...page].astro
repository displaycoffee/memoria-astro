---
/* Scripts */
import type { GetStaticPathsOptions } from 'astro';
import { context } from '../../../context/scripts/context.ts';

/* Components */
import Container from '../../../layout/container/Container.astro';
import Category from '../../../components/category/Category.astro';
import Pagination from '../../../components/pagination/Pagination.astro';

/* Get categories and their posts */
export const getStaticPaths = async ({ paginate }: GetStaticPathsOptions) => {
	const site = await context.wp.site.site();
	const categories = await context.wp.category.all();

	const categoriesWithPosts = await Promise.all(
		categories.map(async (category) => {
			const posts = await context.wp.post.all(category.slug, 'category');
			return { category, posts };
		}),
	);

	return categoriesWithPosts.flatMap(({ category, posts }) => {
		return paginate(posts, {
			params: { slug: category.slug },
			props: { category },
			pageSize: site.pageSize,
		});
	});
};

/* Define prop types */
import type { InferGetStaticPropsType } from 'astro';
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

/* Props */
const { category, page } = Astro.props;

/* Page details */
const pageDetails = {
	path: `/categories/${category.slug}`
};
---

<Container title={category.name}>
	<Category category={category} posts={page.data} />

	<Pagination page={page} basePath={pageDetails.path} />
</Container>
