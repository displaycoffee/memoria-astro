---
/* Scripts */
import { context } from '../context/scripts/context.ts';

/* Components */
import Container from '../layout/container/Container.astro';

/* Basic post fetch */
const res = await fetch(`${context.variables.apiUrl}/posts`);
const posts = await res.json();
---

<Container>
	<h1>Astro + WordPress 🚀</h1>
	{
		posts.map((post: PostType) => (
			<>
				<h2>{post.title.rendered}</h2>
				<div set:html={post.content.rendered} />
			</>
		))
	}
</Container>