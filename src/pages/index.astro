---
/* Styles */
import './index.scss';

/* Basic post fetch */
const res = await fetch("https://memoria.ddev.site/wp-json/wp/v2/posts");
const posts = await res.json();
---

<h1>Astro + WordPress 🚀</h1>
{
  posts.map((post: PostType) => (
      <h2 set:html={post.title.rendered} />
      <p set:html={post.content.rendered} />
  ))
}