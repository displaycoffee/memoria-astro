---
/* Scripts */
import { context } from '../../context/scripts/context.ts';

/* Components */
import Container from '../../layout/container/Container.astro';
import PostList from '../../components/post/PostList.astro';

/* Get posts */
const site = await context.wp.site();
const posts = await context.wp.posts(site.pageSize);
---

<Container>
	<h2>Astro + WordPress 🚀</h2>

	<PostList posts={posts} />
</Container>