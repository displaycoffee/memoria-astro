{
	"name": "memoria-astro",
	"displayName": "Memoria",
	"description": "Astro WordPress theme.",
	"version": "0.0.1",
	"type": "module",
	"keywords": [],
	"author": "displaycoffee",
	"license": "ISC",
	"homepage": "https://github.com/displaycoffee/memoria-astro",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "set NODE_OPTIONS=--use-system-ca && astro dev",
		"build": "set NODE_OPTIONS=--use-system-ca && astro build && npx prettier --write \"dist/**/*.html\" --ignore-path NUL",
		"build:preview": "set NODE_OPTIONS=--use-system-ca && astro build --mode preview && npx prettier --write \"dist/**/*.html\" --ignore-path NUL && astro preview --mode preview",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier --write \"src/**/*.{astro,ts,tsx}\"",
		"lint": "eslint \"src/**/*.{astro,ts,tsx}\" --quiet"
	},
	"devDependencies": {
		"@astrojs/node": "^11.1.5",
		"@astrojs/react": "^6.0.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"globals": "17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.0.0",
		"sass": "^1.104.1"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/displaycoffee/memoria-astro.git"
	},
	"bugs": {
		"url": "https://github.com/displaycoffee/memoria-astro/issues"
	},
	"browserslist": [
		"last 2 versions"
	]
}
